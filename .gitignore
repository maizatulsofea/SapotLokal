google-services.json
app/google-services.json
*.jks
*.keystore
*.env
*.totp-secret

# Android Studio navigation editor backup
*.xml~

# Lint outputs
lint/
**/lint-results*

# OS junk
.DS_Store
Thumbs.db
# Kotlin compiler caches
.kotlin/

# Node (functions/ and tools/seed/)
node_modules/

# Firebase CLI debug logs
*-debug.log

# Local AI-agent tooling (per-machine settings)
.claude/settings.local.json

# JVM heap dumps (from Gradle/lint out-of-memory)
*.hprof
