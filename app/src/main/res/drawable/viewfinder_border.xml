<?xml version="1.0" encoding="utf-8"?>
<!--
    viewfinder_border.xml — the white corner-bracket guide shown over the camera.
    Uses a simple stroked rectangle; Phase 7 can replace with fancy corner brackets.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <stroke
        android:width="2dp"
        android:color="#FFFFFF" />

    <corners android:radius="8dp" />

    <!-- Transparent fill so the camera shows through -->
    <solid android:color="#00000000" />

</shape>
