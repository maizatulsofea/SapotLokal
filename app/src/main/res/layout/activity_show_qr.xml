<?xml version="1.0" encoding="utf-8"?>
<!-- Show QR: the shop's rotating QR, full screen, in the shop's colour. Opened from the owner's bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hu_bg"
    android:keepScreenOn="true"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hu_back"
            android:src="@drawable/ic_arrow_back_hu" />

        <TextView
            style="@style/HU.Text.Screen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/owner_nav_show_qr" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:id="@+id/qrFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_qr_frame"
        android:padding="18dp">

        <ImageView
            android:id="@+id/ivQrCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_hu_card"
            android:contentDescription="@string/owner_qr_cd"
            android:padding="16dp" />
    </FrameLayout>

    <TextView
        style="@style/HU.Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/owner_ask_to_scan" />

    <TextView
        android:id="@+id/tvCountdown"
        style="@style/HU.Text.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        tools:text="New code in 45s" />

    <!-- The same code as text: customers whose camera can't scan type it on their Scan tab. -->
    <TextView
        android:id="@+id/tvCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/figtree_extrabold"
        android:gravity="center"
        android:letterSpacing="0.12"
        android:textColor="@color/hu_ink"
        android:textIsSelectable="true"
        android:textSize="34sp"
        app:fontFamily="@font/figtree_extrabold"
        tools:text="8JFHTA" />

    <TextView
        style="@style/HU.Text.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/owner_code_can_type" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
