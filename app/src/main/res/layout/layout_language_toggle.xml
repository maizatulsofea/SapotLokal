<?xml version="1.0" encoding="utf-8"?>
<!-- EN | BM switch. Wired up by util/AppLanguage.bindToggle(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/languageToggle"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:background="@drawable/bg_lang_container"
    android:orientation="horizontal"
    android:padding="2dp">

    <TextView
        android:id="@+id/langEn"
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:contentDescription="@string/lang_en_name"
        android:fontFamily="@font/figtree_extrabold"
        android:gravity="center"
        android:text="@string/lang_en_short"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/langMs"
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:contentDescription="@string/lang_ms_name"
        android:fontFamily="@font/figtree_extrabold"
        android:gravity="center"
        android:text="@string/lang_ms_short"
        android:textSize="12sp" />
</LinearLayout>
