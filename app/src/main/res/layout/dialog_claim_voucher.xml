<?xml version="1.0" encoding="utf-8"?>
<!-- Reward details shown before a customer claims: shop, reward, cost, terms, validity, Claim button. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="24dp"
    app:cardBackgroundColor="@color/hu_bg"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/hu_line"
    app:strokeWidth="1dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvClaimShop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_medium"
                android:textColor="@color/hu_soft"
                android:textSize="14sp"
                tools:text="Test Cafe" />

            <TextView
                android:id="@+id/tvClaimTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/figtree_bold"
                android:textColor="@color/hu_ink"
                android:textSize="21sp"
                android:textStyle="bold"
                tools:text="Free Coffee" />

            <TextView
                android:id="@+id/tvClaimPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_hu_icon_tile"
                android:fontFamily="@font/figtree_medium"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:textColor="@color/hu_ink"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="50 points" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/figtree_medium"
                android:text="@string/k_terms_heading"
                android:textColor="@color/hu_soft"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvClaimTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/figtree_medium"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/hu_ink"
                android:textSize="14sp"
                tools:text="Valid for dine-in only. One per visit." />

            <TextView
                android:id="@+id/tvClaimValidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:drawablePadding="6dp"
                android:fontFamily="@font/figtree_medium"
                android:textColor="@color/hu_soft"
                android:textSize="12sp"
                app:drawableStartCompat="@drawable/ic_clock"
                app:drawableTint="@color/hu_soft"
                tools:text="Valid for 30 days after you claim" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClaimConfirm"
                style="@style/Widget.HU.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:text="@string/k_claim"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnClaimCancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/figtree_medium"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="@string/k_not_now"
                android:textColor="@color/hu_soft"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
