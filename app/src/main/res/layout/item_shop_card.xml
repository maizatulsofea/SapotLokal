<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/sapot_white"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Category Avatar -->
        <FrameLayout
            android:id="@+id/avatarContainer"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_shop_icon_croissant">

            <ImageView
                android:id="@+id/ivCategoryIcon"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_croissant"
                app:tint="@color/sapot_text_primary" />
        </FrameLayout>

        <!-- Shop Name & Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvShopName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Roti Pagi"
                android:textColor="@color/sapot_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvShopSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Bakery · 350 m · Open until 6 pm"
                android:textColor="@color/sapot_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Points Badge -->
        <TextView
            android:id="@+id/tvShopPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="85 pts"
            android:textColor="@color/sapot_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

