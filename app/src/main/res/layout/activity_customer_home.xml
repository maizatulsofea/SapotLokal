<?xml version="1.0" encoding="utf-8"?>
<!--
    Customer Home — one job: "what can I do now?"
    Header (name opens Me, rank chip opens Play) → top-3 prize if any → one reward card (claim,
    show a voucher, or the next reward with Scan) → your shops as a row of photo cards → Today in
    Play → bottom bar. The full rank card lives on Play; How it works lives on Me.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hu_bg"
    android:orientation="vertical"
    tools:context=".ui.customer.CustomerHomeActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Header: greeting + name, opens Me -->
            <LinearLayout
                android:id="@+id/btnMe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_hu_logo"
                    android:backgroundTint="@color/hu_fill"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="2dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGreetingTime"
                        style="@style/HU.Text.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Selamat pagi" />

                    <TextView
                        android:id="@+id/tvGreeting"
                        style="@style/HU.Text.Screen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/ic_chevron_right_small"
                        android:drawablePadding="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="24sp"
                        tools:text="Farah Hassan" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRankChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_hu_pill"
                    android:backgroundTint="@color/hu_fill"
                    android:fontFamily="@font/figtree_bold"
                    android:minHeight="36dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/hu_ink"
                    android:textSize="13sp"
                    app:fontFamily="@font/figtree_bold"
                    tools:text="Rank 2 · 1,075 XP" />
            </LinearLayout>

            <!-- Unclaimed weekly top-3 prize (PrizeCard) -->
            <FrameLayout
                android:id="@+id/prizeSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone" />

            <!-- The one big reward card (or first-scan card) -->
            <FrameLayout
                android:id="@+id/readySlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp" />

            <TextView
                android:id="@+id/tvMoreReady"
                style="@style/HU.Text.Link"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:visibility="gone"
                tools:text="See 2 more in Rewards"
                tools:visibility="visible" />

            <!-- Load error -->
            <LinearLayout
                android:id="@+id/errorBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_hu_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/HU.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hu_load_error" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    style="@style/Widget.HU.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/hu_try_again" />
            </LinearLayout>

            <!-- Your shops -->
            <LinearLayout
                android:id="@+id/shopsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/HU.Text.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/hu_recently_visited" />

                <TextView
                    android:id="@+id/btnAllShops"
                    style="@style/HU.Text.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:text="@string/hu_see_all" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/shopRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/shopCards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="10dp" />
            </HorizontalScrollView>

            <!-- Today in Play -->
            <LinearLayout
                android:id="@+id/playStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_hu_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_wheel"
                    app:tint="@color/hu_accent_text" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/HU.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hu_today_in_play"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvPlayLine"
                        style="@style/HU.Text.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Free spin ready · 1 mission to claim" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right_small"
                    app:tint="@color/hu_soft" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/customerNav"
        layout="@layout/layout_customer_bottom_nav" />
</LinearLayout>
