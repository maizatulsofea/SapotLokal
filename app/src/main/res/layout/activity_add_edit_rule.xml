<?xml version="1.0" encoding="utf-8"?>
<!-- Add or edit a shop reward: name, cost in points, optional details. Back arrow, no bottom bar. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hu_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/hu_back"
                android:src="@drawable/ic_arrow_back_hu" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/HU.Text.Screen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:accessibilityHeading="true"
                android:text="@string/kv_add_reward_rule" />
        </LinearLayout>

        <TextView
            style="@style/HU.Text.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:labelFor="@id/etRuleName"
            android:text="@string/owner_reward_name" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRuleName"
            style="@style/Widget.HU.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:counterEnabled="true"
            app:counterMaxLength="60"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRuleName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/owner_reward_name_hint"
                android:inputType="textCapSentences"
                android:maxLength="60" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/HU.Text.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:labelFor="@id/etPoints"
            android:text="@string/owner_reward_cost" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPoints"
            style="@style/Widget.HU.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:hintEnabled="false"
            app:suffixText="@string/owner_points_suffix">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/HU.Text.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:labelFor="@id/etRuleDesc"
            android:text="@string/owner_reward_details" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRuleDesc"
            style="@style/Widget.HU.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:counterEnabled="true"
            app:counterMaxLength="120"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRuleDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="@string/owner_reward_details_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="120"
                android:maxLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveRule"
            style="@style/Widget.HU.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/owner_save_reward" />
    </LinearLayout>
</ScrollView>
