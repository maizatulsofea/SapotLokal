<?xml version="1.0" encoding="utf-8"?>
<!-- Customer Profile: who you are (name with edit, rank row), badges, member note, language, then account actions last. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hu_bg"
    android:orientation="vertical"
    tools:context=".ui.customer.CustomerProfileActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Me opens from Home and Play, so it gets a back arrow instead of the bottom bar. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/hu_back"
                    android:src="@drawable/ic_arrow_back_hu" />

                <TextView
                    style="@style/HU.Text.Screen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:accessibilityHeading="true"
                    android:text="@string/customer_bottom_nav_profile" />
            </LinearLayout>

            <!-- Profile card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HU.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        app:cardBackgroundColor="@color/hu_accent_tint"
                        app:cardCornerRadius="48dp"
                        app:cardElevation="0dp"
                        app:cardPreventCornerOverlap="false"
                        app:contentPadding="0dp"
                        app:strokeColor="#F0F5FC"
                        app:strokeWidth="5dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/ivAvatar"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/cd_avatar"
                                android:src="@drawable/ic_user_round"
                                app:tint="@color/hu_ink" />

                            <TextView
                                android:id="@+id/tvAvatarInitials"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/figtree_bold"
                                android:textColor="@color/hu_ink"
                                android:textSize="36sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:text="C" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_edit"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/hu_soft"
                        android:minHeight="48dp"
                        android:gravity="center_vertical"
                        android:fontFamily="@font/figtree_bold"
                        android:textColor="@color/hu_ink"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="Customer One" />

                    <TextView
                        android:id="@+id/tvUserEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/figtree_medium"
                        android:textColor="@color/hu_soft"
                        android:textSize="13sp"
                        tools:text="customer@example.com" />

                    <!-- Rank: one row; the full rank card lives on Play -->
                    <TextView
                        android:id="@+id/tvRankRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_hu_pill"
                        android:backgroundTint="@color/hu_fill"
                        android:fontFamily="@font/figtree_bold"
                        android:gravity="center"
                        android:minHeight="40dp"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/hu_ink"
                        android:textSize="14sp"
                        app:fontFamily="@font/figtree_bold"
                        tools:text="Rank 2 · Pelanggan Setia · 1,075 XP" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Badges: grey until earned; tap one to see how to earn or claim it -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    style="@style/HU.Text.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/customer_profile_badges" />

                <TextView
                    android:id="@+id/tvBadgesUnlockedCount"
                    style="@style/HU.Text.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="3 of 8" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBadges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_badge_tile" />

            <!-- Member since -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HU.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/hu_accent_tint"
                app:strokeColor="#ECEEF2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_status_pill">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_heart"
                            app:tint="@color/hu_ink" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvMemberSince"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/figtree_bold"
                        android:textColor="@color/hu_ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Language -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HU.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/figtree_bold"
                        android:text="@string/customer_profile_language"
                        android:textColor="@color/hu_ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <include
                        android:id="@+id/languageToggle"
                        layout="@layout/layout_language_toggle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Account actions, last on the page -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HU.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">

                    <TextView
                        android:id="@+id/btnHowItWorks"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/figtree_medium"
                        android:gravity="center"
                        android:text="@string/hu_how_points_work"
                        android:textColor="@color/hu_ink"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/rowChangePassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/figtree_medium"
                        android:gravity="center"
                        android:text="@string/customer_profile_change_password"
                        android:textColor="@color/hu_ink"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnSignOut"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/figtree_medium"
                        android:gravity="center"
                        android:text="@string/customer_profile_log_out"
                        android:textColor="@color/hu_ink"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/rowDeleteAccount"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/figtree_medium"
                        android:gravity="center"
                        android:text="@string/customer_profile_delete_account"
                        android:textColor="@color/hu_danger"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/customerNav"
        layout="@layout/layout_customer_bottom_nav" />
</LinearLayout>
