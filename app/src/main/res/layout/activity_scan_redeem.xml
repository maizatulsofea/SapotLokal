<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hu_bg"
    android:orientation="vertical">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:background="@color/hu_bg"
    tools:context=".ui.vendor.ScanRedeemActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hu_bg"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/owner_nav_redeem"
            app:titleTextAppearance="@style/HU.Text.Screen"
            app:titleTextColor="@color/hu_ink" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main content: camera + manual entry stacked vertically -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Camera viewfinder area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000">

            <!-- Camera preview -->
            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Scan reticle / corner brackets frame -->
            <View
                android:id="@+id/scanReticle"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_scan_frame" />

        </FrameLayout>

        <!-- The hint sits under the camera, not on it (same as the customer Scan screen) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/hu_bg"
            android:fontFamily="@font/figtree_bold"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="@string/scan_redeem_point_the_camera_at"
            android:textColor="@color/hu_ink"
            android:textSize="14sp" />

        <!-- Manual code entry card (Figma scanner-card manual entry) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:cardCornerRadius="22dp"
            app:strokeColor="@color/hu_line"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/hu_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/figtree_extrabold"
                    android:text="@string/scan_redeem_enter_voucher_code"
                    android:textColor="@color/hu_ink"
                    android:textSize="15sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilVoucherCode"
                    style="@style/Widget.HU.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/scan_redeem_voucher_code_e_g">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etVoucherCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_medium"
                        android:inputType="textCapCharacters" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitCode"
                    style="@style/Widget.HU.Button"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/scan_redeem_verify"
                    android:textSize="13sp"
                    app:cornerRadius="10dp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:indeterminateTint="@color/hu_accent"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Valid voucher: what to give, to whom, then Mark as used (nothing changes until it is tapped) -->
    <FrameLayout
        android:id="@+id/successOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#991A1C21"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:background="@drawable/bg_hu_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_circle_check"
                app:tint="@color/hu_ok" />

            <TextView
                style="@style/HU.Text.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/owner_valid_voucher"
                android:textColor="@color/hu_ok" />

            <TextView
                android:id="@+id/tvSuccessReward"
                style="@style/HU.Text.Reward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                tools:text="Free kopi" />

            <TextView
                android:id="@+id/tvSuccessCustomer"
                style="@style/HU.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/hu_ink"
                tools:text="For Chong Wei" />

            <TextView
                android:id="@+id/tvSuccessCode"
                style="@style/HU.Text.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                tools:text="Code SAPOT-S1011" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDoneRedeem"
                style="@style/Widget.HU.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/owner_mark_used" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelRedeem"
                style="@style/Widget.HU.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/k_cancel" />
        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

    <include
        android:id="@+id/vendorNav"
        layout="@layout/layout_vendor_bottom_nav" />
</LinearLayout>
