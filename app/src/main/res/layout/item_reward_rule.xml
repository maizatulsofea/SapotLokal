<?xml version="1.0" encoding="utf-8"?>
<!-- A shop reward: name, cost, detail, how often it was claimed, and a labelled switch
     (shown to customers or hidden). Tap the row to edit. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_hu_card"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="80dp"
    android:orientation="horizontal"
    android:paddingVertical="12dp"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRuleName"
            style="@style/HU.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            tools:text="Free kopi" />

        <TextView
            android:id="@+id/tvPointsRequired"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/figtree_bold"
            android:textColor="@color/hu_ink"
            android:textSize="15sp"
            tools:text="10 points" />

        <TextView
            android:id="@+id/tvRuleDescription"
            style="@style/HU.Text.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="One regular kopi of your choice" />

        <TextView
            android:id="@+id/tvClaimed"
            style="@style/HU.Text.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="Claimed 12 times" />

        <TextView
            android:id="@+id/tvVisibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/figtree_bold"
            android:textSize="13sp"
            tools:text="Shown to customers"
            tools:textColor="@color/hu_ok" />
    </LinearLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchActive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="64dp" />
</LinearLayout>
