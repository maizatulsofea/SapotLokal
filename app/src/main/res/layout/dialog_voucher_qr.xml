<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="24dp"
    app:cardBackgroundColor="@color/hu_bg"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/hu_line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Shop Name & Category -->
        <TextView
            android:id="@+id/tvDialogShopName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_medium"
            android:textColor="@color/hu_soft"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Kopi Kita" />

        <!-- Reward Title -->
        <TextView
            android:id="@+id/tvDialogRewardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/figtree_bold"
            android:gravity="center"
            android:textColor="@color/hu_ink"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="A coffee, on us." />

        <!-- QR Code Image Container -->
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_hu_icon_tile"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivVoucherQr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_voucher_qr"
                android:scaleType="fitCenter" />

            <ProgressBar
                android:id="@+id/pbQrLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/hu_ink"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Large Human-Readable Code -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/figtree_bold"
            android:text="@string/voucher_qr_voucher_code"
            android:textColor="@color/hu_soft"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDialogVoucherCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/figtree_bold"
            android:letterSpacing="0.1"
            android:textColor="@color/hu_ink"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="SAPOT-AB12CD" />

        <!-- Expiry Information -->
        <TextView
            android:id="@+id/tvDialogExpiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/figtree_medium"
            android:textColor="@color/hu_soft"
            android:textSize="11sp"
            tools:text="Valid until 24 Nov 2026" />

        <!-- Explanatory note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/figtree_medium"
            android:gravity="center"
            android:text="@string/voucher_qr_show_this_qr_code"
            android:textColor="@color/hu_soft"
            android:textSize="11sp" />

        <!-- Close / Dismiss button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogClose"
            style="@style/Widget.HU.Button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:text="@string/voucher_qr_done"
            android:textSize="13sp"
            app:cornerRadius="10dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
