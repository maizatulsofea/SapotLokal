<?xml version="1.0" encoding="utf-8"?>
<!-- Scan: camera card with scan frame, flashlight, and a manual code box (brand design "Scan & earn"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hu_bg"
    android:orientation="vertical"
    tools:context=".ui.customer.ScanActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/figtree_bold"
                    android:text="@string/customer_bottom_nav_scan"
                    android:textColor="@color/hu_ink"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <!-- Camera card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#F0F2F4"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/hu_line"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp">

                            <TextView
                                android:id="@+id/tvScanStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:drawablePadding="8dp"
                                android:fontFamily="@font/figtree_medium"
                                android:text="@string/scan_starting_camera"
                                android:textColor="@color/hu_soft"
                                android:textSize="12sp"
                                app:drawableStartCompat="@drawable/bg_hu_dot_ok" />

                            <ImageView
                                android:id="@+id/btnFlash"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_alignParentEnd="true"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/cd_flashlight"
                                android:padding="11dp"
                                android:src="@drawable/ic_flash"
                                app:tint="@color/hu_ink" />
                        </RelativeLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="340dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_scan_camera"
                            android:clipToOutline="true">

                            <androidx.camera.view.PreviewView
                                android:id="@+id/previewView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:implementationMode="compatible" />

                            <!-- Scan frame with brown corner brackets -->
                            <FrameLayout
                                android:id="@+id/viewfinder"
                                android:layout_width="210dp"
                                android:layout_height="210dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_hu_scan_frame" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvInstruction"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="@font/figtree_medium"
                            android:gravity="center"
                            android:text="@string/scan_position_the_qr_code"
                            android:textColor="@color/hu_ink"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/figtree_medium"
                            android:gravity="center"
                            android:text="@string/scan_your_camera_is_only"
                            android:textColor="@color/hu_soft"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Type the shop code (for when the camera can't scan) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/codePanel"
                    style="@style/Widget.HU.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/figtree_bold"
                            android:text="@string/scan_enter_a_code"
                            android:textColor="@color/hu_ink"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.HU.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="@string/scan_shop_code">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etShopCode"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="textCapCharacters|textNoSuggestions"
                                android:maxLength="12" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubmitCode"
                            style="@style/Widget.HU.Button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="12dp"
                            android:text="@string/scan_confirm_code" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- Success overlay (hidden until a valid scan) -->
        <LinearLayout
            android:id="@+id/successOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/hu_bg"
            android:clickable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_hu_icon_tile">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_circle_check"
                    app:tint="@color/hu_ink" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvPointsAwarded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/figtree_bold"
                android:textColor="@color/hu_ink"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tvXpAwarded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/figtree_bold"
                android:textColor="@color/hu_accent_text"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Error message -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_margin="20dp"
            android:background="#F7FCEBE7"
            android:fontFamily="@font/figtree_medium"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="@color/hu_danger"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <include
        android:id="@+id/customerNav"
        layout="@layout/layout_customer_bottom_nav" />
</LinearLayout>
