<?xml version="1.0" encoding="utf-8"?>
<!--
    Play tab — one job: "something fun to do".
    Rank card → missions → games → leaderboard. Me (and badges) opens from Home.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hu_bg"
    android:orientation="vertical"
    tools:context=".ui.customer.ChallengesActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/HU.Text.Screen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/hu_play_title" />
            </LinearLayout>

            <include
                android:id="@+id/rankCard"
                layout="@layout/view_rank_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <!-- Unclaimed weekly top-3 prize (PrizeCard) -->
            <FrameLayout
                android:id="@+id/prizeSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone" />

            <!-- Missions (own screen) -->
            <LinearLayout
                android:id="@+id/rowMissions"
                style="@style/HU.ListRow"
                android:layout_marginTop="22dp">
                <ImageView style="@style/HU.TileIcon" android:src="@drawable/ic_circle_check" />
                <LinearLayout style="@style/HU.ListRowText">
                    <TextView style="@style/HU.TileTitle" android:layout_marginTop="0dp" android:text="@string/hu_play_missions" />
                    <TextView android:id="@+id/tvMissionsSub" style="@style/HU.TileSub" tools:text="2 ready to claim" />
                </LinearLayout>
                <ImageView style="@style/HU.Chevron" />
            </LinearLayout>

            <!-- Games -->
            <TextView
                style="@style/HU.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:accessibilityHeading="true"
                android:text="@string/hu_play_games" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardSpin"
                    style="@style/HU.Tile"
                    android:layout_marginEnd="6dp">

                    <ImageView style="@style/HU.TileIcon" android:src="@drawable/ic_wheel" />
                    <TextView style="@style/HU.TileTitle" android:text="@string/hu_spin" />
                    <TextView android:id="@+id/tvSpinSub" style="@style/HU.TileSub" tools:text="Free spin ready" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardMemory"
                    style="@style/HU.Tile"
                    android:layout_marginStart="6dp">

                    <ImageView style="@style/HU.TileIcon" android:src="@drawable/ic_star" />
                    <TextView style="@style/HU.TileTitle" android:text="@string/hu_memory" />
                    <TextView android:id="@+id/tvMemorySub" style="@style/HU.TileSub" tools:text="0 of 60 today" />
                </LinearLayout>
            </LinearLayout>


            <!-- Leaderboard, me -->

            <LinearLayout android:id="@+id/rowLeaderboard" style="@style/HU.ListRow">
                <ImageView style="@style/HU.TileIcon" android:src="@drawable/ic_star" />
                <LinearLayout style="@style/HU.ListRowText">
                    <TextView style="@style/HU.TileTitle" android:text="@string/hu_play_leaderboard" />
                    <TextView android:id="@+id/tvLeaderboardSub" style="@style/HU.TileSub" tools:text="Top 3 win 150, 100 and 75 XP" />
                </LinearLayout>
                <ImageView style="@style/HU.Chevron" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/customerNav"
        layout="@layout/layout_customer_bottom_nav" />
</LinearLayout>
