<?xml version="1.0" encoding="utf-8"?>
<!-- Leaderboard row: place, avatar, name, visits. Also used, tinted, for your own pinned row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_hu_card"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/tvPlace"
        style="@style/HU.Text.Title"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:textSize="17sp"
        tools:text="4" />

    <ImageView
        android:id="@+id/ivAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_avatar_circle"
        android:contentDescription="@null"
        android:padding="3dp" />

    <TextView
        android:id="@+id/tvName"
        style="@style/HU.Text.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="16sp"
        tools:text="Kumar Selvam" />

    <TextView
        android:id="@+id/tvVisits"
        style="@style/HU.Text.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="2 visits" />
</LinearLayout>
