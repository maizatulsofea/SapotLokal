<?xml version="1.0" encoding="utf-8"?>
<!--
    Rank card (BRAND_DESIGN.md §6): rank badge, rank name, the big XP number, a bar to the
    next rank, how far to go, and what the rank gives. Bound by RankCard.bind.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rankCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hu_card"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:importantForAccessibility="no"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvRankBadge"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_rank_badge"
            android:fontFamily="@font/figtree_extrabold"
            android:gravity="center"
            android:textColor="@color/hu_bg"
            android:textSize="20sp"
            tools:text="3" />

        <TextView
            android:id="@+id/tvRankName"
            style="@style/HU.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            tools:text="Kaki Lokal" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="true"
        android:importantForAccessibility="no"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvXp"
            style="@style/HU.Text.Big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="1,650" />

        <TextView
            style="@style/HU.Text.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/figtree_bold"
            android:text="@string/hu_level_score"
            android:textSize="15sp" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/rankBar"
        style="@style/Widget.HU.Progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tvToNext"
        style="@style/HU.Text.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        tools:text="1,850 XP to Otai Lokal" />

    <TextView
        android:id="@+id/tvBonus"
        style="@style/HU.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:importantForAccessibility="no"
        android:textColor="@color/hu_ink"
        tools:text="Your rank gives 1.5x points at every shop" />
</LinearLayout>
