<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hu_bg"
    tools:context=".ui.games.SpinWheelActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/hu_bg"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/hu_ink"
            app:title="@string/games_menu_spin_the_wheel"
            app:titleTextAppearance="@style/HU.Text.Screen"
            app:titleTextColor="@color/hu_ink" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/spinStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hu_icon_tile"
                android:fontFamily="@font/figtree_medium"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/spin_wheel_1_free_spin_every"
                android:textColor="@color/hu_ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="320dp"
                android:layout_height="332dp"
                android:layout_marginTop="20dp">

                <com.sapotlokal.ui.games.WheelView
                    android:id="@+id/wheel"
                    android:layout_width="320dp"
                    android:layout_height="320dp"
                    android:layout_gravity="bottom|center_horizontal" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|center_horizontal"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_wheel_pointer" />
            </FrameLayout>

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/figtree_bold"
                android:gravity="center"
                android:minHeight="40dp"
                android:textColor="@color/hu_ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/spinNowButton"
                style="@style/Widget.HU.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/spin_wheel_spin"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Widget.HU.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/spin_wheel_back" />
        </LinearLayout>
    </LinearLayout>

    <com.sapotlokal.ui.games.ConfettiView
        android:id="@+id/confetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
