<?xml version="1.0" encoding="utf-8"?>
<!-- Colour tokens (BRAND_DESIGN.md §3). Nothing else belongs here. -->
<resources>
    <color name="hu_bg">#FFFFFF</color>               <!-- Page ground, cards, bottom bar -->
    <color name="hu_ink">#1A1C21</color>              <!-- All main text -->
    <color name="hu_soft">#5A606B</color>             <!-- Secondary text (6.4:1 on white); lightest grey for text -->
    <color name="hu_mute">#9AA0AA</color>             <!-- Ticks, dividers, idle icons. Never text -->
    <color name="hu_line">#ECEEF2</color>             <!-- Hairlines and borders -->
    <color name="hu_fill">#F4F5F7</color>             <!-- Quiet fills: inputs, chips, tracks -->
    <color name="hu_accent">#F5A524</color>           <!-- Actions only: main buttons, Scan, active tab, progress -->
    <color name="hu_accent_text">#8A5700</color>      <!-- Orange as text (6.0:1 on white) -->
    <color name="hu_accent_tint">#FFF3DA</color>      <!-- Pale orange wash -->
    <color name="hu_ok">#13734A</color>               <!-- Open now, success -->
    <color name="hu_ok_tint">#E3F6EC</color>
    <color name="hu_danger">#B3261E</color>           <!-- Errors, destructive actions -->
    <color name="hu_ripple">#1F1A1C21</color>

    <!-- Shop palette: one per shop, fixed forever, white text on top. No orange or yellow. -->
    <color name="hu_shop_pink">#E0436A</color>
    <color name="hu_shop_indigo">#4B4FC4</color>
    <color name="hu_shop_purple">#7B4FD6</color>
    <color name="hu_shop_green">#1A9E63</color>
    <color name="hu_shop_blue">#2F6FDE</color>
    <color name="hu_shop_teal">#0F8C8C</color>
    <color name="hu_shop_berry">#A9367F</color>
    <color name="hu_shop_coral">#E86A4A</color>

    <!-- Rank colours (rank badge and rank card only). Rank 5 is ink with an orange ring. -->
    <color name="hu_rank_1">@color/hu_soft</color>
    <color name="hu_rank_2">@color/hu_shop_green</color>
    <color name="hu_rank_3">@color/hu_shop_blue</color>
    <color name="hu_rank_4">@color/hu_shop_purple</color>
    <color name="hu_rank_5">@color/hu_ink</color>

    <!-- Memory Match cards -->
    <color name="game_card_back">@color/hu_ink</color>
    <color name="game_card_back_text">@color/hu_accent</color>
    <color name="game_card_front">@color/hu_bg</color>
    <color name="game_card_front_stroke">@color/hu_line</color>
    <color name="game_card_front_text">@color/hu_ink</color>
    <color name="game_card_matched">@color/hu_ok_tint</color>
    <color name="game_card_matched_stroke">@color/hu_ok</color>
    <color name="game_gold">@color/hu_accent</color>
</resources>
