<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base SapotLokal theme.
        Parent = Material Components Light NoActionBar.
    -->
    <style name="Theme.SapotLokal" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Canvas & Surface Backgrounds -->
        <item name="android:windowBackground">@color/sapot_canvas</item>
        <item name="android:colorBackground">@color/sapot_canvas</item>
        <item name="colorSurface">@color/sapot_surface</item>
        <item name="colorOnSurface">@color/sapot_text_primary</item>
        <item name="colorOnBackground">@color/sapot_text_primary</item>

        <!-- Brand Primary (Sunny yellow & dark brown ink - NEVER white on yellow) -->
        <item name="colorPrimary">@color/sapot_primary</item>
        <item name="colorPrimaryVariant">@color/sapot_primary</item>
        <item name="colorOnPrimary">@color/sapot_on_primary</item>

        <!-- Secondary & Accents -->
        <item name="colorSecondary">@color/sapot_accent_subtle</item>
        <item name="colorSecondaryVariant">@color/sapot_accent_subtle</item>
        <item name="colorOnSecondary">@color/sapot_text_primary</item>

        <!-- Feedback & Outlines -->
        <item name="colorError">@color/sapot_error_text</item>
        <item name="colorOnError">@color/sapot_surface</item>
        <item name="colorOutline">@color/sapot_border</item>

        <!-- System Bars Styling (Light status and navigation bars with dark icons) -->
        <item name="android:statusBarColor">@color/sapot_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/sapot_canvas</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Default App Typography -->
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>

        <!-- Default Component Styles -->
        <item name="materialButtonStyle">@style/Widget.SapotLokal.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.SapotLokal.Card</item>
        <item name="textInputStyle">@style/Widget.SapotLokal.TextInputLayout</item>
    </style>

    <!-- Splash theme — full-screen background, no status bar chrome -->
    <style name="Theme.SapotLokal.Splash" parent="Theme.SapotLokal">
        <item name="android:windowBackground">@color/splashBackground</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/splashBackground</item>
    </style>
</resources>
