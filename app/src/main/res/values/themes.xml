<?xml version="1.0" encoding="utf-8"?>
<!-- The one app theme (BRAND_DESIGN.md): white ground, ink text, one orange for actions, Figtree. -->
<resources>
    <style name="Base.Theme.SapotLokal" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/hu_bg</item>
        <item name="android:colorBackground">@color/hu_bg</item>
        <item name="colorSurface">@color/hu_bg</item>
        <item name="colorOnSurface">@color/hu_ink</item>
        <item name="colorOnBackground">@color/hu_ink</item>
        <item name="colorPrimary">@color/hu_accent</item>
        <item name="colorPrimaryVariant">@color/hu_accent_text</item>
        <item name="colorOnPrimary">@color/hu_ink</item>
        <item name="colorSecondary">@color/hu_accent</item>
        <item name="colorSecondaryVariant">@color/hu_accent_text</item>
        <item name="colorOnSecondary">@color/hu_ink</item>
        <item name="colorError">@color/hu_danger</item>
        <item name="colorOnError">@color/hu_bg</item>
        <item name="colorOutline">@color/hu_line</item>
        <item name="colorControlActivated">@color/hu_accent</item>
        <item name="colorControlHighlight">@color/hu_ripple</item>
        <item name="android:textColorPrimary">@color/hu_ink</item>
        <item name="android:textColorSecondary">@color/hu_soft</item>

        <item name="android:statusBarColor">@color/hu_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/hu_bg</item>

        <item name="fontFamily">@font/figtree_medium</item>
        <item name="android:fontFamily">@font/figtree_medium</item>

        <item name="materialButtonStyle">@style/Widget.HU.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.HU.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.HU.Button.Text</item>
        <item name="materialCardViewStyle">@style/Widget.HU.Card</item>
        <item name="textInputStyle">@style/Widget.HU.TextInputLayout</item>
        <item name="chipStyle">@style/Widget.HU.Chip</item>
        <item name="switchStyle">@style/Widget.HU.Switch</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.HU.BottomSheet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.HU.Dialog</item>
    </style>

    <style name="Theme.SapotLokal" parent="Base.Theme.SapotLokal" />

    <!-- Splash: same ground, nothing else. -->
    <style name="Theme.SapotLokal.Splash" />
</resources>
